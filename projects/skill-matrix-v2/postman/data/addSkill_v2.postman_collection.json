{
  "info": {
    "name": "Skill Hierarchy V2 API",
    "_postman_id": "skill-hierarchy-v2-collection",
    "description": "Postman collection for the Skill Hierarchy V2 Cloud Function.\nCovers GET, POST (single), POST (batch), POST (bulk-upload), PUT, DELETE.\n\nSet the {{base_url}} collection variable to your Cloud Function URL:\n  Local dev:  http://localhost:8080\n  GCP Dev:    https://asia-south1-<project>.cloudfunctions.net/dev_add_skill_v2\n  GCP Prod:   https://asia-south1-<project>.cloudfunctions.net/add_skill_v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Base URL. Change to your deployed Cloud Function URL."
    }
  ],
  "item": [
    {
      "name": "GET \u2014 Fetch Skill Hierarchies",
      "description": "Fetch all skill hierarchies or a single one by id query param.",
      "item": [
        {
          "name": "GET All Skill Hierarchies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "/"
              ]
            },
            "description": "Returns all skill hierarchy entries with joined data. Expected: 200 with count + results array."
          },
          "response": []
        },
        {
          "name": "GET Single Skill Hierarchy by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?id=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "/"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "skill_hierarchy_id"
                }
              ]
            },
            "description": "Returns a single entry by id. Expected: 200. If not found: 404."
          },
          "response": []
        },
        {
          "name": "GET Single \u2014 Not Found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?id=99999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "/"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "99999"
                }
              ]
            },
            "description": "Tests 404 when id does not exist."
          },
          "response": []
        }
      ]
    },
    {
