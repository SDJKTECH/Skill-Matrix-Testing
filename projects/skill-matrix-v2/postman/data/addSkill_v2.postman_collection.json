    {
      "name": "POST \u2014 Bulk Upload CSV",
      "description": "Upload a CSV file to bulk-import skill hierarchies. Uses multipart/form-data.\nRequired CSV columns: Category, Sub-Category, Sub-Sub-Category, Tools\nOptional columns: L1, L2, L3\n\nSample CSV:\nCategory,Sub-Category,Sub-Sub-Category,Tools,L1,L2,L3\nEngineering,Cloud,DevOps,Terraform,Write HCL,Manage state,Multi-cloud\nData Science,Analytics,ML,Scikit-learn,Use classifiers,Pipelines,Custom estimators",
      "item": [
        {
          "name": "POST Bulk Upload \u2014 CSV File (201)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "employee_id",
                  "value": "1",
                  "type": "text",
                  "description": "Employee with dept/admin role"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "CSV file with columns: Category, Sub-Category, Sub-Sub-Category, Tools, L1, L2, L3"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/bulk-upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bulk-upload"
              ]
            },
            "description": "Attach CSV file with key 'file'. Expected: 201 with created/skipped/faulty_rows summary."
          },
          "response": []
        },
        {
          "name": "POST Bulk Upload \u2014 Missing employee_id (400)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Any CSV file"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/bulk-upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bulk-upload"
              ]
            },
            "description": "Expected: 400 Missing required field: employee_id."
          },
          "response": []
        },
        {
          "name": "POST Bulk Upload \u2014 No File Attached (400)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "employee_id",
                  "value": "1",
                  "type": "text"
