    {
      "name": "DELETE \u2014 Remove Skill Hierarchy",
      "description": "Delete a skill hierarchy link. Orphaned master entries auto-cleaned. Blocked (409) if employee_skills reference it.",
      "item": [
        {
          "name": "DELETE Skill Hierarchy \u2014  (200)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?id=5&employee_id=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "/"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "5",
                  "description": "Change to actual skill_hierarchy_id in your DB"
                },
                {
                  "key": "employee_id",
                  "value": "1"
                }
              ]
            },
            "description": "Deletes id=5 and auto-cleans orphaned master entries. Expected: 200 with orphaned_masters_deleted list."
          },
          "response": []
        },
