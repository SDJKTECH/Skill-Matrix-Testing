    {
      "name": "POST \u2014 Add Batch Skills",
      "description": "Add multiple skill hierarchies in one request using the skills array key.",
      "item": [
        {
          "name": "POST Batch Skills \u2014  (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": 1,\n  \"skills\": [\n    {\n      \"discipline_name\": \"Engineering\",\n      \"domain_name\": \"Cloud\",\n      \"skill_area\": \"DevOps\",\n      \"framework_name\": \"Docker\",\n      \"basic\": \"Build and run containers\",\n      \"intermediate\": \"Multi-stage Dockerfiles, compose services\",\n      \"expert\": \"Optimize images, build CI/CD pipelines\"\n    },\n    {\n      \"discipline_name\": \"Engineering\",\n      \"domain_name\": \"Cloud\",\n      \"skill_area\": \"DevOps\",\n      \"framework_name\": \"Helm\",\n      \"basic\": \"Install and list charts\",\n      \"intermediate\": \"Write custom Helm charts\",\n      \"expert\": \"Manage complex release strategies\"\n    },\n    {\n      \"discipline_name\": \"Data Science\",\n      \"domain_name\": \"Analytics\",\n      \"skill_area\": \"Machine Learning\",\n      \"framework_name\": \"PyTorch\",\n      \"basic\": \"Understand tensors and autograd\",\n      \"intermediate\": \"Train and evaluate neural network models\",\n      \"expert\": \"Custom CUDA kernels and distributed training\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "/"
              ]
            },
            "description": "Creates 3 skills in one call. Expected: 201 with summary (created, already_exists, errors) and per-item results."
          },
          "response": []
        },
        {
          "name": "POST Batch Skills \u2014 Partial Errors (mixed results)",
          "request": {
            "method": "POST",
