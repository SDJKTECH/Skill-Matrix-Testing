                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "/"
              ]
            },
            "description": "Creates a new skill hierarchy with all optional fields. Expected: 201."
