              "raw": "{\n  \"employee_id\": 1,\n  \"skills\": [\n    {\n      \"discipline_name\": \"Engineering\",\n      \"domain_name\": \"Cloud\",\n      \"skill_area\": \"DevOps\",\n      \"framework_name\": \"Ansible\"\n    },\n    {\n      \"discipline_name\": \"Engineering\",\n      \"domain_name\": \"Cloud\",\n      \"skill_area\": \"DevOps\"\n    },\n    {\n      \"discipline_name\": \"QA\",\n      \"domain_name\": \"Testing\",\n      \"skill_area\": \"Automation\",\n      \"framework_name\": \"Selenium\"\n    }\n  ]\n}",
