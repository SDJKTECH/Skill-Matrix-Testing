{
  "info": {
    "name": "Employee Training V2 API",
    "_postman_id": "employee-training-v2-collection",
    "description": "Postman collection for the addTraining_v2 Cloud Function.\nCovers employee-training enrollments (GET, POST single/batch/bulk-upload, PUT, DELETE, suggestions, report download) and training batches (GET/POST/PUT/DELETE /training_batch).\n\nSet the {{base_url}} collection variable to your Cloud Function URL:\n  Local dev:  http://localhost:8080\n  GCP Dev:    https://asia-south1-<project>.cloudfunctions.net/dev_addTraining_v2\n  GCP Prod:   https://asia-south1-<project>.cloudfunctions.net/addTraining_v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Base URL. Change to your deployed Cloud Function URL."
    },
    {
      "key": "admin_id",
      "value": "2",
      "type": "string",
      "description": "Admin employee ID with dept/department/admin/hr role, used to authorize writes."
    },
    {
      "key": "employee_id",
      "value": "1",
      "type": "string",
      "description": "Target employee ID to enroll in a training."
    },
    {
      "key": "created_employee_training_id",
      "value": "",
      "type": "string",
      "description": "Auto-set by the POST Single Enrollment test; used by PUT/DELETE requests."
    },
    {
      "key": "created_batch_id",
      "value": "",
      "type": "string",
      "description": "Auto-set by the POST Training Batch test; used by GET/PUT/DELETE /training_batch requests."
    }
  ],
  "item": [
    {
      "name": "GET — Fetch Employee Training Records",
      "description": "Fetch all training enrollments, or filter by id / employee_id / batch_id.",
      "item": [
        {
          "name": "GET All Training Records",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "Returns all employee_trainings rows with joined employee/batch/hierarchy data. Expected: 200 with count + results array."
          },
          "response": []
        },
        {
          "name": "GET Single Training by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?id={{created_employee_training_id}}",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "id", "value": "{{created_employee_training_id}}", "description": "employee_training_id" }
              ]
            },
            "description": "Returns a single training object (not wrapped in results). Expected: 200. If not found: 404."
          },
          "response": []
        },
        {
          "name": "GET All Trainings for an Employee",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?employee_id={{employee_id}}",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "employee_id", "value": "{{employee_id}}" }
              ]
            },
            "description": "Returns count + results ordered by created_at DESC for the given employee. Expected: 200."
          },
          "response": []
        },
        {
          "name": "GET All Trainings for a Batch",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?batch_id={{created_batch_id}}",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "batch_id", "value": "{{created_batch_id}}" }
              ]
            },
            "description": "Returns count + results for all enrollments in the given batch. Expected: 200."
          },
          "response": []
        },
        {
          "name": "GET Single — Not Found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?id=999999",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "id", "value": "999999" }
              ]
            },
            "description": "Tests 404 when id does not exist."
          },
          "response": []
        },
        {
          "name": "GET — Invalid id Parameter (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?id=abc",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "id", "value": "abc" }
              ]
            },
            "description": "id is not an integer. Expected: 400."
          },
          "response": []
        }
      ]
    },
    {
      "name": "GET — Suggestion Endpoints",
      "description": "Autocomplete/dropdown data. All use ?suggest=<type>, GET only.",
      "item": [
        {
          "name": "Suggest — Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?suggest=employees&q=Kumar",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "suggest", "value": "employees" },
                { "key": "q", "value": "Kumar" }
              ]
            },
            "description": "ILIKE search on emp_id/name/email, max 20 results. Expected: 200 with results array."
          },
          "response": []
        },
        {
          "name": "Suggest — Competency",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?suggest=competency",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "suggest", "value": "competency" }
              ]
            },
            "description": "Distinct non-empty competency values from employee_trainings. Expected: 200."
          },
          "response": []
        },
        {
          "name": "Suggest — Training Hierarchy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?suggest=training_hierarchy",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "suggest", "value": "training_hierarchy" }
              ]
            },
            "description": "All training_hierarchy_links rows joined with area/subarea/module names. Expected: 200."
          },
          "response": []
        },
        {
          "name": "Suggest — Employee Type (enum)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?suggest=employee_type",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "suggest", "value": "employee_type" }
              ]
            },
            "description": "Static enum values: New Lateral, Existing Lateral, Freshers, Customer, Interns. Expected: 200."
          },
          "response": []
        },
        {
          "name": "Suggest — Training Status (enum)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?suggest=training_status",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "suggest", "value": "training_status" }
              ]
            },
            "description": "Static enum values: Not Started, In Progress, Completed, Not Completed. Expected: 200."
          },
          "response": []
        },
        {
          "name": "Suggest — Batch Status (enum)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?suggest=batch_status",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "suggest", "value": "batch_status" }
              ]
            },
            "description": "Static enum values: Planned, Open, In Progress, Completed, Cancelled, Archived. Expected: 200."
          },
          "response": []
        },
        {
          "name": "Suggest — Training Mode (enum)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?suggest=training_mode",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "suggest", "value": "training_mode" }
              ]
            },
            "description": "Static enum values: Internal Videos, External Platforms, Hybrid, Internal Instructor-led, External Instructor-led. Expected: 200."
          },
          "response": []
        },
        {
          "name": "Suggest — Unknown Type (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?suggest=xyz",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "suggest", "value": "xyz" }
              ]
            },
            "description": "Unrecognized suggest type. Expected: 400 with list of valid types."
          },
          "response": []
        }
      ]
    },
    {
      "name": "GET — Download Bulk Upload Report",
      "description": "Proxy-downloads the latest bulk upload Excel report from GCS.",
      "item": [
        {
          "name": "Download Report — Latest (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?download_report=latest&admin_id={{admin_id}}",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "download_report", "value": "latest" },
                { "key": "admin_id", "value": "{{admin_id}}" }
              ]
            },
            "description": "Streams bulk_upload_report_latest.xlsx as an attachment. Expected: 200. If never generated: 404."
          },
          "response": []
        },
        {
          "name": "Download Report — Missing admin_id (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?download_report=latest",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "download_report", "value": "latest" }
              ]
            },
            "description": "Expected: 401 admin_id is required for report download."
          },
          "response": []
        },
        {
          "name": "Download Report — Unauthorized Role (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?download_report=latest&admin_id=999",
              "host": ["{{base_url}}"],
              "path": ["/"],
              "query": [
                { "key": "download_report", "value": "latest" },
                { "key": "admin_id", "value": "999", "description": "Non-admin employee" }
              ]
            },
            "description": "admin_id=999 should be a non-admin employee in your DB. Expected: 403."
          },
          "response": []
        }
      ]
    },
    {
      "name": "POST — Create Single Enrollment",
      "description": "Create one employee-training enrollment. Hierarchy and batch are auto-resolved/created.",
      "item": [
        {
          "name": "POST Single Enrollment — Full Fields (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('created_employee_training_id', body.employee_training_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"employee_id\": {{employee_id}},\n  \"area\": \"Cloud Computing\",\n  \"subarea\": \"AWS Services\",\n  \"module\": \"Lambda Functions\",\n  \"batch_num\": \"BATCH-2026-07\",\n  \"area_description\": \"Cloud platforms and services\",\n  \"subarea_description\": \"Amazon Web Services\",\n  \"module_course_level\": \"Intermediate\",\n  \"module_description\": \"Serverless compute\",\n  \"competency\": \"Cloud Architecture\",\n  \"employee_type\": \"Existing Lateral\",\n  \"nominated_by\": \"Preethi TS\",\n  \"start_date\": \"2026-07-01\",\n  \"end_date\": \"2026-07-15\",\n  \"Batch Description\": \"July cohort\",\n  \"Training Mode\": \"External Instructor-led\",\n  \"Training Quarter\": \"Q3 2026\",\n  \"Trainer\": \"Anita Rao\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "Creates a new enrollment; if batch_num doesn't exist yet, creates the batch with the pass-through fields too. Expected: 201. Saves employee_training_id to {{created_employee_training_id}}."
          },
          "response": []
        },
        {
          "name": "POST Single Enrollment — Minimal Required Fields",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"employee_id\": {{employee_id}},\n  \"area\": \"DevOps\",\n  \"subarea\": \"CI/CD\",\n  \"module\": \"GitHub Actions\",\n  \"batch_num\": \"BATCH-2026-08\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "Only required fields — no descriptions, competency, or dates. training_status auto-derives to 'Not Started'. Expected: 201."
          },
          "response": []
        },
        {
          "name": "POST Single Enrollment — Duplicate (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"employee_id\": {{employee_id}},\n  \"area\": \"Cloud Computing\",\n  \"subarea\": \"AWS Services\",\n  \"module\": \"Lambda Functions\",\n  \"batch_num\": \"BATCH-2026-07\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "Same employee_id + batch_num as the Full Fields request above. Expected: 409 with existing_employee_training_id."
          },
          "response": []
        },
        {
          "name": "POST Single Enrollment — Batch/Hierarchy Mismatch (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"employee_id\": {{employee_id}},\n  \"area\": \"Data Science\",\n  \"subarea\": \"Analytics\",\n  \"module\": \"Pandas\",\n  \"batch_num\": \"BATCH-2026-07\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "batch_num 'BATCH-2026-07' already exists under a different hierarchy (Cloud Computing/AWS Services/Lambda Functions). resolve_training_batch raises ConflictError. Expected: 409."
          },
          "response": []
        },
        {
          "name": "POST Single Enrollment — Missing Required Fields (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"area\": \"Cloud Computing\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "Missing employee_id, subarea, module, batch_num. Expected: 400 with missing fields list."
          },
          "response": []
        },
        {
          "name": "POST Single Enrollment — Invalid Employee Type (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"employee_id\": {{employee_id}},\n  \"area\": \"Cloud Computing\",\n  \"subarea\": \"AWS Services\",\n  \"module\": \"S3 & Storage\",\n  \"batch_num\": \"BATCH-2026-09\",\n  \"employee_type\": \"Not A Real Type\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "employee_type is not a valid enum value. Expected: 400."
          },
          "response": []
        },
        {
          "name": "POST Single Enrollment — Target Employee Not Found (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"employee_id\": 999999,\n  \"area\": \"Cloud Computing\",\n  \"subarea\": \"AWS Services\",\n  \"module\": \"S3 & Storage\",\n  \"batch_num\": \"BATCH-2026-09\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "employee_id=999999 does not exist. Expected: 404."
          },
          "response": []
        },
        {
          "name": "POST Single Enrollment — Unauthorized Role (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": 999,\n  \"employee_id\": {{employee_id}},\n  \"area\": \"Cloud Computing\",\n  \"subarea\": \"AWS Services\",\n  \"module\": \"S3 & Storage\",\n  \"batch_num\": \"BATCH-2026-09\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "admin_id=999 should be a non-admin employee in your DB. Expected: 403 Access denied."
          },
          "response": []
        }
      ]
    },
    {
      "name": "POST — Create Batch Enrollments (trainings array)",
      "description": "Create multiple enrollments in one request. admin_id authorizes the whole request once.",
      "item": [
        {
          "name": "POST Batch Enrollments —  (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"trainings\": [\n    {\n      \"employee_id\": 1,\n      \"area\": \"Cloud Computing\",\n      \"subarea\": \"AWS Services\",\n      \"module\": \"S3 & Storage\",\n      \"batch_num\": \"BATCH-2026-10\",\n      \"employee_type\": \"Existing Lateral\",\n      \"start_date\": \"2026-07-01\"\n    },\n    {\n      \"employee_id\": 2,\n      \"area\": \"DevOps\",\n      \"subarea\": \"CI/CD\",\n      \"module\": \"GitHub Actions\",\n      \"batch_num\": \"BATCH-2026-11\",\n      \"employee_type\": \"Freshers\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "Creates 2 enrollments in one call. Expected: 201 with summary (created, already_exists, errors) and per-item results."
          },
          "response": []
        },
        {
          "name": "POST Batch Enrollments — Partial Errors (mixed results)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"trainings\": [\n    {\n      \"employee_id\": 1,\n      \"area\": \"Cloud Computing\",\n      \"subarea\": \"AWS Services\",\n      \"module\": \"EC2\",\n      \"batch_num\": \"BATCH-2026-12\"\n    },\n    {\n      \"employee_id\": 1,\n      \"area\": \"Cloud Computing\"\n    },\n    {\n      \"employee_id\": 2,\n      \"area\": \"QA\",\n      \"subarea\": \"Testing\",\n      \"module\": \"Selenium\",\n      \"batch_num\": \"BATCH-2026-13\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "Item 2 is missing subarea/module/batch_num. Expected: items 1 & 3 created, item 2 returns an error result. summary.errors: 1."
          },
          "response": []
        },
        {
          "name": "POST Batch Enrollments — Empty Array (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"admin_id\": {{admin_id}},\n  \"trainings\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "trainings array is empty. Expected: 400 'trainings array is empty'."
          },
          "response": []
        },
        {
          "name": "POST Batch Enrollments — Missing admin_id (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainings\": [\n    {\n      \"employee_id\": 1,\n      \"area\": \"Cloud Computing\",\n      \"subarea\": \"AWS Services\",\n      \"module\": \"EC2\",\n      \"batch_num\": \"BATCH-2026-12\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": ["/"]
            },
            "description": "Missing admin_id at the top level. Expected: 400 Missing required field: admin_id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "POST — Bulk Upload Enrollments (CSV/Excel)",
      "description": "Upload a CSV or Excel file to bulk-create/update enrollments, grouped by batch_num.\nRequired columns: batch_num, Employee ID, Area, Sub Area, Module\nOptional columns: Batch Description, Area Description, Sub Area Description, Module Course Level, Module Description, Employee Type, Start Date, End Date, Competency, Training Status, Status Remarks, Nominated By, Training Mode, Training Quarter, Batch Status, Batch Status Remarks, Duration, Trainer, Batch Size, Prerequisite, Training Content, Resources\n\nSample CSV:\nbatch_num,Employee ID,Area,Sub Area,Module,Start Date,Employee Type\nBATCH-2026-14,000001,Cloud Computing,AWS Services,VPC,2026-07-01,Existing Lateral\nBATCH-2026-14,000002,Cloud Computing,AWS Services,VPC,2026-07-01,Freshers",
      "item": [
        {
          "name": "POST Bulk Upload — CSV File (201)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "admin_id",
                  "value": "{{admin_id}}",
                  "type": "text",
                  "description": "Employee with dept/department/admin/hr role"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "CSV/Excel file with columns: batch_num, Employee ID, Area, Sub Area, Module, ..."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/bulk-upload",
              "host": ["{{base_url}}"],
              "path": ["bulk-upload"]
